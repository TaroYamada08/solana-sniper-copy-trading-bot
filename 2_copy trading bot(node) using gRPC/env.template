# =============================================================================
# SOLANA TRADING BOT CONFIGURATION
# =============================================================================

# =============================================================================
# ESSENTIAL CONFIGURATION
# =============================================================================
# Your wallet private key (base58 encoded)
PRIVATE_KEY=your_wallet_private_key_here

# Solana RPC endpoint (Helius, QuickNode, Alchemy, etc.)
RPC_URL=https://your-rpc-endpoint.com

# Triton One gRPC endpoint for transaction streaming
GRPC_ENDPOINT=https://your-grpc-endpoint.com

# Triton One authentication token
GRPCTOKEN=your_grpc_token_here

# =============================================================================
# TRADING PARAMETERS
# =============================================================================
# Amount of SOL to use for each snipe
SNIPERAMOUNT=0.1

# Wallet must have at least this much SOL to start
MIN_WALLET_SOL=0.05

# Cap each buy to this fraction of wallet balance
POSITION_PCT_OF_WALLET=0.08

# Profit target multiplier (used for alerts; trailing/scale-out handle most exits)
PROFIT_TARGET=2.0

# Hard stop loss multiplier (e.g. 0.55 = 45% down)
STOP_LOSS=0.55

# Maximum time to hold a sniper/copy position (ms)
MAX_HOLD_TIME=180000

# Trailing stop from peak (0.18 = sell after 18% drop off highs)
TRAILING_STOP_PCT=0.18
TIGHT_TRAIL_PCT=0.10
TIME_TIGHTEN_AFTER_MS=60000

# Panic-sell if price dumps this much within DUMP_WINDOW_MS
DUMP_DROP_PCT=0.12
DUMP_WINDOW_MS=8000

# Scale-out: take profit in pieces (ratio:fraction, comma-separated)
SCALE_OUT=1.6:0.35,2.5:0.35

# Minimum / maximum pool liquidity in SOL
MIN_LIQUIDITY=3
MAX_LIQUIDITY=80

# Ignore dust launches and likely bundled dev buys
MIN_LAUNCH_BUY_SOL=0.05
MAX_LAUNCH_BUY_SOL=25
SKIP_LARGE_DEV_BUY=true

# Maximum concurrent positions
MAX_POSITIONS=5

# =============================================================================
# STRATEGY MODES
# =============================================================================
# Sniper: buy new mints from PumpFun / PumpSwap / LaunchLab
ENABLE_SNIPER=true

# Copy-trade specific wallets (comma-separated)
ENABLE_COPY=false
TARGET_WALLETS=
COPY_RATIO=1.0
MIN_COPY_SOL=0.01
MAX_COPY_SOL=0.2
# mirror = sell when they sell, smart = ignore their sells, hybrid = sell half
COPY_SELL_MODE=hybrid

# Cross-route arbitrage via Jupiter round-trip quotes
ENABLE_ARBITRAGE=true
ARB_MIN_SPREAD_BPS=80
ARB_SIZE_SOL=0.05
ARB_MAX_LEG_HOLD_MS=12000
ARB_SCAN_INTERVAL_MS=2500
ARB_MAX_WATCHLIST=40
ARB_COOLDOWN_MS=20000
ARB_MIN_LIQUIDITY=8

# =============================================================================
# POOL FILTERS
# =============================================================================
# Enable/disable specific pool types
ENABLE_PUMPFUN=true
ENABLE_PUMPSWAP=true
ENABLE_RAYDIUM_LAUNCHLAB=true
ENABLE_RAYDIUM_CPMM=true

# =============================================================================
# SWAP CONFIGURATION
# =============================================================================
# Swap method: solana, race, nozomi, 0slot
SWAP_METHOD=solana

# Jupiter slippage in basis points (5000 = 50%)
SLIPPAGE_BPS=5000

# Slippage tolerance percentage
SLIPPAGE_TOLERANCE=1.0

# Priority fee in lamports
PRIORITY_FEE=1000

# =============================================================================
# RISK MANAGEMENT
# =============================================================================
# Maximum daily loss in SOL
MAX_DAILY_LOSS=1.0

# Maximum single trade loss in SOL
MAX_SINGLE_LOSS=0.5

# Cooldown period between trades in milliseconds
TRADE_COOLDOWN=5000

# =============================================================================
# NOTIFICATIONS
# =============================================================================
# Telegram bot configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Discord webhook
DISCORD_WEBHOOK_URL=your_webhook_url_here

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable debug mode
DEBUG=false

# Log to file
LOG_TO_FILE=true

# Log file path
LOG_FILE_PATH=./logs/trading-bot.log

# =============================================================================
# API KEYS (Optional)
# =============================================================================
# Helius API key for enhanced RPC
HELIUS_API_KEY=your_helius_key_here

# Jupiter API key for better swap rates
JUPITER_API_KEY=your_jupiter_key_here

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================
# Enable MEV protection
ENABLE_MEV_PROTECTION=true

# Enable backtesting mode
BACKTEST_MODE=false

# Enable paper trading
PAPER_TRADING=false

# Optional web dashboard at http://localhost:3000
ENABLE_DASHBOARD=false
DASHBOARD_PORT=3000

# Database connection (for position tracking)
DATABASE_URL=sqlite://./trades.db

# =============================================================================
# PERFORMANCE OPTIMIZATION
# =============================================================================
# Transaction retry attempts
MAX_RETRIES=3

# Retry delay in milliseconds
RETRY_DELAY=1000

# Connection timeout in milliseconds
CONNECTION_TIMEOUT=30000

# =============================================================================
# SECURITY
# =============================================================================
# Enable rate limiting
ENABLE_RATE_LIMITING=true

# Maximum requests per minute
MAX_REQUESTS_PER_MINUTE=100

# Enable IP whitelist
ENABLE_IP_WHITELIST=false

# Allowed IP addresses (comma-separated)
ALLOWED_IPS=127.0.0.1,::1
